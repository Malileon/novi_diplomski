<%= turbo_stream_from "topics" %>
<main class="container">
  <%= link_to sanitize("&larr; Back to home page"), root_path %>
  <div class="header">
    <h1>Topics</h1>
    <% if current_user != nil %>
      <% if current_user.is_admin == 1 %>
        <%= link_to "New topic",
                    new_topic_path,
                    class: "btn btn--primary",
                    data: { turbo_frame: dom_id(Topic.new) } %>
      <% end %>
    <% end %>
  </div>

  <%= turbo_frame_tag Topic.new do %>
    <% if @topics.none? %>
      <%= render "topics/empty_state" %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "topics", class:"topic__container" do %>
    <%= render @topics %>
  <% end %>
</main>