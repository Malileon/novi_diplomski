<main class="container">
  <%= link_to sanitize("&larr; Back to home page"), root_path %>
  <div class="auth">
    <h2 class="auth__item">Sign up</h2>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= f.error_notification %>
      <div class="form-inputs">
        <%= f.input :username,
                    required: true,
                    autofocus: true,
                    placeholder: "Enter your username",
                    input_html: { class: "auth__item", title: "Must be unique" } %>
        <%= f.input :email,
                    required: true,
                    placeholder: "Enter your email",
                    input_html: { autocomplete: "email", class: "auth__item", :title => "Proper e-mail form is required. Example: name@something" } %>
        <%= f.input :password,
                    required: true,
                    placeholder: "Enter your password",
                    input_html: { autocomplete: "new-password", class: "auth__item", :title => "Required lenght: 6 characters" } %>
        <%= f.input :password_confirmation,
                    required: true,
                    placeholder: "Enter your password again",
                    input_html: { autocomplete: "new-password", class: "auth__item", :title => "Required lenght: 6 characters" } %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, 
                    "Sign up",
                    data: {turbo: false},
                    id: 'auth-button' %>
      </div>
    <% end %>

    <div class="auth__item">Already have an account?</div>
    <%= render "devise/shared/links" %>
  </div>
</main>